{
    "name": "bot",
    "version": "1.0.0",
    "private": true,
    "description": "A Discord bot for the Undertale/Deltarune Wiki server, made through Cloudflare Workers.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/utdrwiki/bot.git"
    },
    "keywords": [
        "discord",
        "bot",
        "cloudflare",
        "workers",
        "typescript"
    ],
    "author": {
        "name": "Luka Simić",
        "email": "git@kocka.tech",
        "url": "https://kocka.tech"
    },
    "license": "MIT",
    "scripts": {
        "deploy": "wrangler deploy",
        "start": "wrangler dev",
        "cf-typegen": "wrangler types",
        "lint": "eslint . --ext .js,.ts",
        "register": "tsx scripts/register.ts",
        "register-prod": "tsx scripts/register.ts --prod",
        "post-talktostaff": "tsx scripts/post-talktostaff.ts",
        "post-verify": "tsx scripts/post-verify.ts",
        "post-talktostaff-prod": "tsx scripts/post-talktostaff.ts --prod",
        "post-verify-prod": "tsx scripts/post-verify.ts --prod",
        "typecheck": "tsc --noEmit -p ."
    },
    "dependencies": {
        "@discordjs/rest": "2.6.3",
        "discord-api-types": "0.38.47",
        "discord-interactions": "4.4.0",
        "node-html-parser": "9.0.1"
    },
    "devDependencies": {
        "@types/node": "26.4.0",
        "@typescript-eslint/eslint-plugin": "8.66.0",
        "@typescript-eslint/parser": "8.66.0",
        "dotenv": "17.4.2",
        "eslint": "8.57.0",
        "eslint-plugin-jsdoc": "63.3.3",
        "eslint-plugin-promise": "7.3.0",
        "tsx": "4.23.9",
        "typescript": "6.0.2",
        "wrangler": "4.127.1"
    },
    "allowScripts": {
        "esbuild": false,
        "workerd": false
    }
}
